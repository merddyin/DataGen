<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateSeededCatalogDatabase>true</GenerateSeededCatalogDatabase>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyntheticEnterprise.Contracts\SyntheticEnterprise.Contracts.csproj" />
    <ProjectReference Include="..\SyntheticEnterprise.Core\SyntheticEnterprise.Core.csproj" />
    <ProjectReference Include="..\SyntheticEnterprise.Exporting\SyntheticEnterprise.Exporting.csproj" />
    <ProjectReference Include="..\SyntheticEnterprise.PluginHost\SyntheticEnterprise.PluginHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(DataGenCatalogArtifactPath)" Link="catalogs\catalogs.sqlite">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>catalogs\catalogs.sqlite</TargetPath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Cmdlets\Get-SEModuleCommandSurface.cs" Link="Recovered\Cmdlets\Get-SEModuleCommandSurface.cs" />
  </ItemGroup>

  <Target Name="CopySqliteNativeBinary" AfterTargets="Build">
    <ItemGroup>
      <SqliteNative Include="$(OutDir)runtimes\win-x64\native\e_sqlite3.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SqliteNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(SqliteNative.FullPath)')" />
  </Target>

  <Target Name="CopyPluginHostArtifacts" AfterTargets="Build" Condition="'$(UseArtifactsOutput)' == 'true'">
    <ItemGroup>
      <PluginHostArtifact Include="$(ArtifactsPath)\bin\SyntheticEnterprise.PluginHost\$([System.String]::Copy('$(Configuration)').ToLowerInvariant())\SyntheticEnterprise.PluginHost.dll" />
      <PluginHostArtifact Include="$(ArtifactsPath)\bin\SyntheticEnterprise.PluginHost\$([System.String]::Copy('$(Configuration)').ToLowerInvariant())\SyntheticEnterprise.PluginHost.deps.json" />
      <PluginHostArtifact Include="$(ArtifactsPath)\bin\SyntheticEnterprise.PluginHost\$([System.String]::Copy('$(Configuration)').ToLowerInvariant())\SyntheticEnterprise.PluginHost.runtimeconfig.json" />
      <PluginHostArtifact Include="$(ArtifactsPath)\bin\SyntheticEnterprise.PluginHost\$([System.String]::Copy('$(Configuration)').ToLowerInvariant())\SyntheticEnterprise.PluginHost.exe" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <Error Condition="!Exists('%(PluginHostArtifact.FullPath)')" Text="Expected PluginHost build artifact '%(PluginHostArtifact.FullPath)' was not produced in the isolated artifacts output." />
    <Copy SourceFiles="@(PluginHostArtifact)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
